<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.shawnhuang.Eventrail.backup</string>
			<key>UTTypeDescription</key>
			<string>Eventrail Backup</string>
			<!-- public.data only. Conforming to public.archive as well handed
			     the file to the Files app's own archive handling, which tapped
			     it, failed to unpack it and said "inappropriate file type or
			     format" instead of passing it to Eventrail. -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>eventrail</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
