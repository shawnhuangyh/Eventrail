{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run on Simulator",
            "detail": "Build Eventrail, install it on the simulator, and stream its log.",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/run-simulator.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Install (wait for debugger)",
            "detail": "Build and install Eventrail, then launch it suspended for a debugger.",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/run-simulator.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "SIM_WAIT_FOR_DEBUGGER": "1"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
