    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventrail keeps a calendar of its own for the events in your library. It reads back only that calendar, to correct and remove its own entries."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventrailは、ライブラリ内のイベント用に専用カレンダーを作成します。自分で追加した予定の修正と削除のために、そのカレンダーだけを読み取ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventrail 会为资料库中的活动维护一个专用日历。它只会读取该日历，以修正和移除自己创建的日程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventrail 會為資料庫中的活動維護一個專用日曆。它只會讀取該日曆，以修正和移除自己建立的日程。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventrail adds an event's flyer to your photos when you ask it to save one. It never reads your photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存を選んだときに、Eventrailはイベントのフライヤーを写真に追加します。写真を読み取ることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你选择存储时，Eventrail 会将活动海报添加到“照片”。它不会读取你的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你選擇儲存時，Eventrail 會將活動海報加入「照片」。它不會讀取你的照片。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}