    },
    "Eventernote has published nothing upcoming for the performers you follow. New dates appear here as they are listed." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォロー中の出演者について、Eventernoteには今後の予定がまだ公開されていません。新しい日程が掲載されると、ここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventernote 尚未发布你所关注艺人的近期活动。新日期发布后会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventernote 尚未發布你所關注藝人的近期活動。新日期發布後會顯示在這裡。"
          }
        }
      }
    },
    "Eventernote is asking the app to slow down. Try again in a few minutes." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventernoteからアクセス頻度を下げるよう求められました。数分後にもう一度お試しください。"
