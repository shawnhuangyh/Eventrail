        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们的日期将不再显示在此设备及其他设备的“关注”中。你的 Eventernote 账号仍收藏的艺人会在下次刷新时恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他們的日期將不再顯示在此裝置及其他裝置的“關注”中。你的 Eventernote 帳號仍收藏的藝人會在下次重新整理時恢復。"
          }
        }
      }
