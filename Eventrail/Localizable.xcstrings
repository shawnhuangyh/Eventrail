    },
    "A companion for Eventernote: browse events, keep your own record of what you have been to and what you are going to, and follow the performers you care about." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventernoteのためのコンパニオンアプリ。イベントを探し、参加した公演とこれから行く公演を記録し、気になる出演者をフォローできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventernote 的好搭档：浏览活动，记录你参加过和即将参加的演出，并关注你在意的艺人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventernote 的好搭檔：瀏覽活動，記錄你參加過和即將參加的演出，並關注你在意的藝人。"
          }
        }
      }
    },
    "A restore only ever adds. Everything already on this device stays as it is." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元は追加するだけです。このデバイスにある内容はそのまま残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复只会添加内容，此设备上已有的一切都会保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢復只會新增內容，此裝置上已有的一切都會保持不變。"
          }
        }
      }
    },
